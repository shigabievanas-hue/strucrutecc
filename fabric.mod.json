package com.example.structurecopier;

import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.client.gui.widget.ButtonWidget;
import net.minecraft.client.gui.widget.TextFieldWidget;
import net.minecraft.item.Item;
import net.minecraft.item.ItemStack;
import net.minecraft.text.Text;
import net.minecraft.util.math.BlockPos;

import java.util.List;

/**
 * The whole mod in one menu (RIGHT CTRL or /sc menu). Tabs:
 * 0 Build (start/stop, walking, airplace, chest, speed), 1 Structure (placement, shift, rotate),
 * 2 Library (corners, name, save, load, rename, delete), 3 Resources (what is still needed).
 */
public class MenuScreen extends Screen {
    private static int tab = 0;
    private static String nameText = "";

    public static MenuScreen open(int t) { tab = t; return new MenuScreen(); }

    private static final String[] TABS = {"Стройка", "Постройка", "Библиотека", "Ресурсы"};
    private static final int ROW = 22, RES_ROW = 20;

    private ButtonWidget bBuild, bWalk, bAir, bManual, bDist, bDelay, bChest, bP1, bP2;
    private TextFieldWidget nameField;
    private String status = "", confirmDelete, confirmOverwrite, missingText = "";
    private int infoY, contentY, page, pages = 1, scroll, tickN, left = -1;
    private boolean emptyLib;
    private List<Builder.Res> rows = List.of();

    public MenuScreen() { super(Text.literal("Structure Copier")); }

    private static String onOff(boolean v) { return v ? "§aВКЛ" : "§cВЫКЛ"; }

    private ButtonWidget add(String label, int x, int y, int w, ButtonWidget.PressAction action) {
        return addDrawableChild(ButtonWidget.builder(Text.literal(label), action).dimensions(x, y, w, 20).build());
    }

    private Builder b() { return StructureCopierClient.builder; }

    private void msg(String s) {
        if (client != null && client.player != null) Builder.msg(client.player, s);
    }

    @Override
    protected void init() {
        int W = Math.min(196, (width - 24) / 2);
        int L = width / 2 - W - 6, R = width / 2 + 6, full = 2 * W + 12;
        int g = 24, y = 8;

        int tw = (full - 12) / 4;
        for (int i = 0; i < TABS.length; i++) {
            final int idx = i;
            ButtonWidget t = add(TABS[i], L + i * (tw + 4), y, tw, btn -> { tab = idx; page = 0; scroll = 0; clearAndInit(); });
            t.active = tab != i;
        }
        y += g + 4;
        contentY = y;

        switch (tab) {
            case 0 -> initBuildTab(L, R, W, full, y, g);
            case 1 -> initStructureTab(L, R, W, full, y, g);
            case 2 -> initLibraryTab(L, R, W, full, y, g);
            default -> initResourcesTab(full, L);
        }
        refresh();
    }

    // ================= tab 0: build =================
    private void initBuildTab(int L, int R, int W, int full, int y, int g) {
        Builder b = b();
        bBuild = add("", L, y, full, btn -> { b.toggleAuto(client != null ? client.player : null); refresh(); });
        y += g;
        bWalk = add("", L, y, W, btn -> { b.autoWalk = !b.autoWalk; refresh(); });
        bAir = add("", R, y, W, btn -> { b.airplace = !b.airplace; b.reset(); refresh(); });
        y += g;
        bManual = add("", L, y, W, btn -> { b.manualAirplace = !b.manualAirplace; refresh(); });
        add("-", R, y, 20, btn -> { b.airDist = Math.max(2, b.airDist - 1); refresh(); });
        bDist = add("", R + 22, y, W - 44, btn -> {});
        add("+", R + W - 20, y, 20, btn -> { b.airDist = Math.min(5, b.airDist + 1); refresh(); });
        y += g;
        add("-", L, y, 20, btn -> { b.delay = Math.max(1, b.delay - 1); refresh(); });
        bDelay = add("", L + 22, y, W - 44, btn -> {});
        add("+", L + W - 20, y, 20, btn -> { b.delay = Math.min(20, b.delay + 1); refresh(); });
        add("Остановить и сбросить попытки", R, y, W, btn -> { b.running = false; b.reset(); msg("Сброшено"); });
        y += g;
        bChest = add("", L, y, W, btn -> { msg(StructureCopierClient.setChest()); refresh(); });
        add("Сбросить склад", R, y, W, btn -> { b.chestPos = null; refresh(); });
        y += g;
        infoY = y;
        y += 28;
        add("Закрыть", L, y, full, btn -> close());
    }

    // ================= tab 1: structure placement =================
    private void initStructureTab(int L, int R, int W, int full, int y, int g) {
        Builder b = b();
        add("Поставить на блок под взглядом", L, y, full, btn -> {
            if (b.schem == null) { msg("Сначала загрузи постройку (вкладка «Библиотека»)"); return; }
            b.origin = StructureCopierClient.lookedAbove();
            b.reset();
            msg("Угол постройки: " + b.origin.toShortString());
        });
        y += g;
        shiftRow("X", L, y, W, 0);
        shiftRow("Y", R, y, W, 1);
        y += g;
        shiftRow("Z", L, y, W, 2);
        add("Повернуть на 90°", R, y, W, btn -> {
            if (b.schem == null) { msg("Сначала загрузи постройку (вкладка «Библиотека»)"); return; }
            b.schem.rotate();
            b.reset();
        });
        y += g;
        infoY = y;
        y += 28;
        add("Закрыть", L, y, full, btn -> close());
    }

    private void shiftRow(String axis, int x, int y, int w, int a) {
        add("-", x, y, 20, btn -> shift(a, -1));
        add("Сдвиг " + axis + " (Shift = 10)", x + 22, y, w - 44, btn -> {});
        add("+", x + w - 20, y, 20, btn -> shift(a, 1));
    }

    private void shift(int axis, int dir) {
        Builder b = b();
        if (b.origin == null) { msg("Сначала загрузи постройку (вкладка «Библиотека»)"); return; }
        int d = dir * (hasShiftDown() ? 10 : 1);
        b.origin = b.origin.add(axis == 0 ? d : 0, axis == 1 ? d : 0, axis == 2 ? d : 0);
        b.reset();
    }

    // ================= tab 2: library =================
    private void initLibraryTab(int L, int R, int W, int full, int y, int g) {
        nameField = new TextFieldWidget(textRenderer, L, y, full, 20, Text.literal("Название"));
        nameField.setMaxLength(32);
        nameField.setPlaceholder(Text.literal("Название постройки"));
        nameField.setText(nameText);
        nameField.setChangedListener(s -> nameText = s);
        addDrawableChild(nameField);
        setInitialFocus(nameField);
        y += g;

        bP1 = add("", L, y, W, btn -> { StructureCopierClient.pos1 = StructureCopierClient.looked(); refresh(); });
        bP2 = add("", R, y, W, btn -> { StructureCopierClient.pos2 = StructureCopierClient.looked(); refresh(); });
        y += g;
        add("Сохранить выделение", L, y, W, btn -> save(false));
        add("Сохранить загруженную", R, y, W, btn -> save(true));
        y += g + 2;

        List<String> names = Library.list();
        emptyLib = names.isEmpty();
        int pageSize = Math.max(1, (height - y - 66) / ROW);
        pages = Math.max(1, (names.size() + pageSize - 1) / pageSize);
        page = Math.max(0, Math.min(page, pages - 1));

        int renameW = 62, delW = 46, loadW = full - renameW - delW - 4;
        for (int i = page * pageSize; i < Math.min(names.size(), (page + 1) * pageSize); i++) {
            final String n = names.get(i);
            add(n + " §7" + Library.info(n), L, y, loadW, btn -> load(n));
            add("Переим.", L + loadW + 2, y, renameW, btn -> rename(n));
            add(n.equals(confirmDelete) ? "§cТочно?" : "Удалить", L + loadW + renameW + 4, y, delW, btn -> delete(n));
            y += ROW;
        }

        int cx = width / 2;
        add("<", cx - 60 - 24, height - 26, 20, btn -> { page--; clearAndInit(); });
        add("Закрыть", cx - 60, height - 26, 120, btn -> close());
        add(">", cx + 60 + 4, height - 26, 20, btn -> { page++; clearAndInit(); });
    }

    private void save(boolean loaded) {
        String name = Library.clean(nameText);
        if (name.isEmpty()) { status = "§cВведи название"; return; }
        if (Library.exists(name) && !name.equals(confirmOverwrite)) {
            confirmOverwrite = name;
            status = "§eТакое имя уже есть. Нажми ещё раз, чтобы перезаписать";
            return;
        }
        confirmOverwrite = null;
        Library.Result r = loaded ? Library.saveLoaded(name) : Library.saveSelection(name);
        status = (r.ok() ? "§a" : "§c") + r.msg();
        if (r.ok()) nameText = "";
        clearAndInit();
    }

    private void load(String n) {
        Library.Result r = Library.load(n);
        status = (r.ok() ? "§a" : "§c") + r.msg();
        if (r.ok()) { msg(r.msg()); tab = 1; page = 0; }
        clearAndInit();
    }

    private void rename(String n) {
        Library.Result r = Library.rename(n, nameText);
        status = (r.ok() ? "§a" : "§c") + r.msg();
        if (r.ok()) nameText = "";
        confirmDelete = null;
        clearAndInit();
    }

    private void delete(String n) {
        if (!n.equals(confirmDelete)) {
            confirmDelete = n;
            status = "§eНажми «Точно?», чтобы удалить «" + n + "»";
            clearAndInit();
            return;
        }
        confirmDelete = null;
        Library.Result r = Library.delete(n);
        status = (r.ok() ? "§a" : "§c") + r.msg();
        clearAndInit();
    }

    // ================= tab 3: resources =================
    private void initResourcesTab(int full, int L) {
        add("Закрыть", width / 2 - 60, height - 26, 120, btn -> close());
        reloadResources();
    }

    private int visibleRes() { return Math.max(1, (height - contentY - 34 - 34) / RES_ROW); }

    private void reloadResources() {
        if (client == null) return;
        rows = b().resources(client.world, client.player);
        scroll = Math.max(0, Math.min(scroll, Math.max(0, rows.size() - visibleRes())));
    }

    private static String stacks(int need, int max) {
        return max > 1 && need > max ? need + " (" + ((need + max - 1) / max) + " ст.)" : String.valueOf(need);
    }

    // ================= shared =================
    private void refresh() {
        Builder b = b();
        if (tab == 0 && bBuild != null) {
            bBuild.setMessage(Text.literal("Старт/стоп (airplace + ходьба): " + onOff(b.running)));
            bWalk.setMessage(Text.literal("Авто-ходьба: " + onOff(b.autoWalk)));
            bAir.setMessage(Text.literal("Airplace в стройке: " + onOff(b.airplace)));
            bManual.setMessage(Text.literal("Airplace (ПКМ): " + onOff(b.manualAirplace)));
            bDist.setMessage(Text.literal("Дистанция: " + b.airDist));
            bDelay.setMessage(Text.literal("Задержка: " + b.delay + " т."));
            bChest.setMessage(Text.literal(b.chestPos == null ? "Склад: §cзадать (смотри на сундук)" : "Склад: §a" + b.chestPos.toShortString()));
        } else if (tab == 2 && bP1 != null) {
            bP1.setMessage(Text.literal(posLabel("Угол 1", StructureCopierClient.pos1)));
            bP2.setMessage(Text.literal(posLabel("Угол 2", StructureCopierClient.pos2)));
        }
    }

    private static String posLabel(String name, BlockPos p) {
        return p == null ? name + ": §cзадать (смотри на блок)" : name + ": §a" + p.toShortString();
    }

    @Override
    public void tick() {
        if (client == null) return;
        tickN++;
        Builder b = b();
        if (tickN % 10 == 0) {
            left = (b.schem != null && b.origin != null && client.world != null) ? b.remaining(client.world) : -1;
            StringBuilder sb = new StringBuilder();
            for (Item i : b.missing()) sb.append(i.getName().getString()).append(", ");
            missingText = sb.toString();
            if (tab == 0) refresh();
        }
        if (tab == 3 && tickN % 20 == 0) reloadResources();
    }

    @Override
    public boolean mouseScrolled(double mouseX, double mouseY, double horizontalAmount, double verticalAmount) {
        int s = (int) Math.signum(verticalAmount);
        if (tab == 3) {
            scroll = Math.max(0, Math.min(scroll - s * 2, Math.max(0, rows.size() - visibleRes())));
            return true;
        }
        if (tab == 2 && s != 0) {
            page = Math.max(0, Math.min(page - s, pages - 1));
            clearAndInit();
            return true;
        }
        return super.mouseScrolled(mouseX, mouseY, horizontalAmount, verticalAmount);
    }

    @Override
    public void removed() { Library.saveSettings(); }

    @Override
    public boolean shouldPause() { return false; }

    @Override
    public void render(DrawContext ctx, int mouseX, int mouseY, float delta) {
        super.render(ctx, mouseX, mouseY, delta);
        Builder b = b();
        int cx = width / 2;
        String name = b.schem == null ? null : (b.schem.name == null || b.schem.name.isEmpty() ? "без имени" : b.schem.name);

        switch (tab) {
            case 0 -> {
                String st = b.schem == null ? "Постройка не загружена (вкладка «Библиотека»)"
                        : "Статус: " + (b.running ? "§aидёт" : "§cстоп") + "§r   Осталось: " + (left < 0 ? "?" : left);
                ctx.drawCenteredTextWithShadow(textRenderer, Text.literal(st), cx, infoY + 2, 0xFFFFFFFF);
                if (!missingText.isEmpty())
                    ctx.drawCenteredTextWithShadow(textRenderer,
                            Text.literal("§eНе хватает: " + textRenderer.trimToWidth(missingText, width - 90)), cx, infoY + 13, 0xFFFFFFFF);
            }
            case 1 -> {
                String l1 = b.schem == null ? "Постройка не загружена"
                        : "Загружено: " + name + " (" + b.schem.blocks.size() + " бл., " + b.schem.sx + "x" + b.schem.sy + "x" + b.schem.sz + ")";
                ctx.drawCenteredTextWithShadow(textRenderer, Text.literal(l1), cx, infoY + 2, 0xFFFFFFFF);
                if (b.origin != null)
                    ctx.drawCenteredTextWithShadow(textRenderer, Text.literal("Угол постройки: " + b.origin.toShortString()), cx, infoY + 13, 0xFFAAAAAA);
            }
            case 2 -> {
                if (emptyLib) ctx.drawCenteredTextWithShadow(textRenderer, Text.literal("Пока нет сохранённых построек"), cx, height / 2 + 20, 0xFFAAAAAA);
                if (!status.isEmpty()) ctx.drawCenteredTextWithShadow(textRenderer, Text.literal(status), cx, height - 58, 0xFFFFFFFF);
                ctx.drawCenteredTextWithShadow(textRenderer, Text.literal("Стр. " + (page + 1) + "/" + pages), cx, height - 44, 0xFFAAAAAA);
            }
            default -> renderResources(ctx, b);
        }
    }

    private void renderResources(DrawContext ctx, Builder b) {
        int cx = width / 2;
        String sum = b.schem == null ? "Постройка не загружена (вкладка «Библиотека»)"
                : (b.schem.name == null || b.schem.name.isEmpty() ? "" : "«" + b.schem.name + "»: ")
                + "осталось " + (left < 0 ? "?" : left) + " из " + b.schem.blocks.size();
        ctx.drawCenteredTextWithShadow(textRenderer, Text.literal(sum), cx, contentY + 2, 0xFFDDDDDD);

        int xName = 28, xNeed = (int) (width * 0.50), xHave = (int) (width * 0.68), xChest = (int) (width * 0.82);
        int hy = contentY + 18, top = hy + 14;
        ctx.drawTextWithShadow(textRenderer, Text.literal("Блок"), xName, hy, 0xFFAAAAAA);
        ctx.drawTextWithShadow(textRenderer, Text.literal("Нужно"), xNeed, hy, 0xFFAAAAAA);
        ctx.drawTextWithShadow(textRenderer, Text.literal("Есть"), xHave, hy, 0xFFAAAAAA);
        ctx.drawTextWithShadow(textRenderer, Text.literal("Сундук"), xChest, hy, 0xFFAAAAAA);

        int n = Math.min(rows.size() - scroll, visibleRes());
        for (int i = 0; i < n; i++) {
            Builder.Res r = rows.get(scroll + i);
            int y = top + i * RES_ROW;
            ItemStack st = new ItemStack(r.item());
            ctx.drawItem(st, 8, y - 4);
            String nm = textRenderer.trimToWidth(r.item().getName().getString(), xNeed - xName - 6);
            ctx.drawTextWithShadow(textRenderer, Text.literal(nm), xName, y, 0xFFFFFFFF);
            ctx.drawTextWithShadow(textRenderer, Text.literal(stacks(r.need(), st.getMaxCount())), xNeed, y, 0xFFFFFFFF);
            ctx.drawTextWithShadow(textRenderer, Text.literal(String.valueOf(r.have())), xHave, y,
                    r.have() >= r.need() ? 0xFF55FF55 : 0xFFFF5555);
            ctx.drawTextWithShadow(textRenderer, Text.literal(r.chest() < 0 ? "?" : String.valueOf(r.chest())), xChest, y,
                    r.chest() < 0 ? 0xFFAAAAAA : 0xFFFFFFFF);
        }
        if (rows.isEmpty() && b.schem != null)
            ctx.drawCenteredTextWithShadow(textRenderer, Text.literal("Всё построено или ресурсов не нужно"), cx, top + 10, 0xFF55FF55);
    }
}
